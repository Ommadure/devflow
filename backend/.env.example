# DevFlow API configuration. Copy once: `cp -n .env.example .env` (-n never overwrites).
# Values here suit running the API on your machine against `docker compose up -d`.
# docker-compose.yml overrides DATABASE_URL and REDIS_URL for the containerised API.

# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------------------
# Neon hands out postgres://…?sslmode=require URLs; they are accepted as-is.
DATABASE_URL=postgresql+asyncpg://devflow:devflow@localhost:5434/devflow
# Alembic only. In production: Neon's *direct* (non "-pooler") host. Empty = DATABASE_URL.
DATABASE_DIRECT_URL=

REDIS_URL=redis://localhost:6380/0

# --- Auth ---------------------------------------------------------------------------
# SECRET. At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Keep true. Set false only if your browser drops Secure cookies on http://localhost (Safari).
COOKIE_SECURE=true

# Comma-separated browser origins allowed to call the API (CORS + the refresh Origin check).
CORS_ORIGINS=http://localhost:5173

# --- Embeddings (Phase 4) -------------------------------------------------------------
# fastembed = bge-small locally (downloaded on first use, ~65 MB); fake = test vectors.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Must match the model (checked at startup) and the database column, vector(384).
EMBEDDING_DIM=384
FASTEMBED_CACHE_PATH=.cache/fastembed

# --- LLM features (Phase 5) ---------------------------------------------------------
# gemini = real answers (needs GEMINI_API_KEY); fake = canned answers, no key, no cost.
# The API refuses to start with LLM_PROVIDER=gemini and no key.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
# SECRET. From https://aistudio.google.com/apikey
GEMINI_API_KEY=
# USD per 1M tokens [input, output], from the provider's pricing page; used for ai_usage.cost_usd.
# Unpriced models are recorded at cost 0. Example: LLM_PRICING={"gemini-3.5-flash": [0.30, 2.50]}
LLM_PRICING={}
# Hidden "thinking" tokens count against the output limit; minimal suits these tasks.
LLM_THINKING_LEVEL=minimal
AI_DAILY_QUOTA_PER_USER=50
# "Ask your notes" answers "not found" (without calling the LLM) below this similarity.
NOTES_MIN_SIMILARITY=0.6

# --- GitHub (Phase 6) ----------------------------------------------------------------
# SECRET. A token with NO scopes (public data only) raises the limit from 60 to 5,000
# requests an hour. Optional: without it the overview still works, within 60/hour.
GITHUB_TOKEN=

# --- Error reporting (optional) ---------------------------------------------------------
# SECRET-ish (lets anyone send events to your project). Empty = Sentry off.
SENTRY_DSN=
