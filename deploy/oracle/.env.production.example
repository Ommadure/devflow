# Copy to deploy/oracle/.env.production ON THE VM and fill in (docs/deploy.md, step 5).
# The real file is git-ignored; never commit it or paste it anywhere.

# Caddy serves the API over HTTPS on this name (your DuckDNS subdomain). Also update the
# rewrite in frontend/vercel.json if you change it.
API_DOMAIN=devflow-om.duckdns.org

APP_ENV=production
LOG_LEVEL=INFO

# --- Database: Neon ---------------------------------------------------------------------
# SECRET. The POOLED connection string (host contains "-pooler"): the API and the worker.
DATABASE_URL=
# SECRET. The DIRECT connection string (same, without "-pooler"): migrations only.
DATABASE_DIRECT_URL=

# REDIS_URL is set by compose.yaml (the redis service); nothing to fill in.

# --- Auth -------------------------------------------------------------------------------
# SECRET. python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
COOKIE_SECURE=true
# The Vercel domain(s), comma-separated, no trailing slash. Also the refresh Origin check.
CORS_ORIGINS=https://devflow-om.vercel.app

# --- AI ---------------------------------------------------------------------------------
EMBEDDING_PROVIDER=fastembed
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
# SECRET. From https://aistudio.google.com/apikey
GEMINI_API_KEY=
LLM_THINKING_LEVEL=minimal
LLM_PRICING={}
AI_DAILY_QUOTA_PER_USER=50

# --- Optional ---------------------------------------------------------------------------
# SECRET. A GitHub token with no scopes: 5,000 requests/hour instead of 60.
GITHUB_TOKEN=
# SECRET-ish. Empty = Sentry off.
SENTRY_DSN=
