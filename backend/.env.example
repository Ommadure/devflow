# DevFlow API configuration. Copy once: `cp -n .env.example .env` (-n never overwrites).
# Values here suit running the API on your machine against `docker compose up -d`.
# docker-compose.yml overrides DATABASE_URL and REDIS_URL for the containerised API.

# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------------------
# Neon hands out postgres://…?sslmode=require URLs; they are accepted as-is.
DATABASE_URL=postgresql+asyncpg://devflow:devflow@localhost:5434/devflow
# Alembic only. In production: Neon's *direct* (non "-pooler") host. Empty = DATABASE_URL.
DATABASE_DIRECT_URL=

REDIS_URL=redis://localhost:6380/0

# --- Auth ---------------------------------------------------------------------------
# SECRET. At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Keep true. Set false only if your browser drops Secure cookies on http://localhost (Safari).
COOKIE_SECURE=true

# Comma-separated browser origins allowed to call the API (CORS + the refresh Origin check).
CORS_ORIGINS=http://localhost:5173

# --- Embeddings (Phase 4) -------------------------------------------------------------
# fastembed = bge-small locally (downloaded on first use, ~65 MB); fake = test vectors.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Must match the model (checked at startup) and the database column, vector(384).
EMBEDDING_DIM=384
FASTEMBED_CACHE_PATH=.cache/fastembed

# --- Error reporting (optional) ---------------------------------------------------------
# SECRET-ish (lets anyone send events to your project). Empty = Sentry off.
SENTRY_DSN=
